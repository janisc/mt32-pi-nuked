+boolean CI2CMaster::IsSDAStuckLow (void) const
+{
+	const u32 nSDAMask = BIT (s_GPIOConfig[m_nDevice][m_nConfig][GPIO_SDA]);
+
+	// The bus is idle after a transfer, so SDA must be released (high)
+	for (unsigned i = 0; i < 3; i++)
+	{
+		if (CGPIOPin::ReadAll () & nSDAMask)
+		{
+			return FALSE;
+		}
+
+		CTimer::SimpleusDelay (10);
+	}
+
+	return TRUE;
+}
+
+// Standard I2C bus recovery: a slave left in the middle of a byte (e.g. after the
+// controller gave up on a transfer) keeps SDA low until it sees more clocks. Clock
+// SCL by hand until SDA is released, then send START and STOP to reset all slaves.
+boolean CI2CMaster::RecoverBus (void)
+{
+	const u32 nSDAMask = BIT (s_GPIOConfig[m_nDevice][m_nConfig][GPIO_SDA]);
+
+	DisableAdapter ();
+
+	// Take over the pins as GPIOs; open drain is emulated with input (released) and output low
+	m_SDA.SetMode (GPIOModeInputPullUp);
+	m_SCL.SetMode (GPIOModeInputPullUp);
+	CTimer::SimpleusDelay (10);
+
+	for (unsigned i = 0; i < 9 && !(CGPIOPin::ReadAll () & nSDAMask); i++)
+	{
+		m_SCL.Write (LOW);
+		m_SCL.SetMode (GPIOModeOutput);
+		CTimer::SimpleusDelay (10);
+		m_SCL.SetMode (GPIOModeInputPullUp);
+		CTimer::SimpleusDelay (10);
+	}
+
+	// START (SDA falls while SCL is high), then STOP (SDA rises while SCL is high)
+	m_SDA.Write (LOW);
+	m_SDA.SetMode (GPIOModeOutput);
+	CTimer::SimpleusDelay (10);
+	m_SDA.SetMode (GPIOModeInputPullUp);
+	CTimer::SimpleusDelay (10);
+
+	const boolean bRecovered = !!(CGPIOPin::ReadAll () & nSDAMask);
+
+	// Hand the pins back to the controller, configured as in the constructor
+	m_SDA.SetMode (ALT_FUNC (m_nDevice, m_nConfig));
+	m_SDA.SetPullMode (GPIOPullModeUp);
+	m_SCL.SetMode (ALT_FUNC (m_nDevice, m_nConfig));
+	m_SCL.SetPullMode (GPIOPullModeUp);
+
+	if (bRecovered)
+	{
+		g_nI2CMasterRecoveries++;
+	}
+	else
+	{
+		g_nI2CMasterRecoveryFailures++;
+	}
+
+	return bRecovered;
+}
